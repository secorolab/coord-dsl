ns left = "https://secorolab.github.io/models/coordination/fsm/left-arm/"

FSM (ns=left) left_arm {
STATES: IDLE,MOVING_TO_TAKE_POSE,AT_TAKE_POSE,PLACING,PLACED
START_STATE: @IDLE
END_STATE: @PLACED
EVENTS: TAKE_POSE,TAKE_POSE_DONE,PLACE,PLACE_DONE
TRANSITIONS:
    MOVE_TAKE_POSE:
        FROM: @IDLE
        TO: @MOVING_TO_TAKE_POSE
    FINISH_TAKE_POSE:
        FROM: @MOVING_TO_TAKE_POSE
        TO: @AT_TAKE_POSE
    START_PLACE:
        FROM: @AT_TAKE_POSE
        TO: @PLACING
    FINISH_PLACE:
        FROM: @PLACING
        TO: @PLACED
REACTIONS:
    ON_TAKE_POSE:
        WHEN: @TAKE_POSE
        DO: @MOVE_TAKE_POSE
    ON_TAKE_POSE_DONE:
        WHEN: @TAKE_POSE_DONE
        DO: @FINISH_TAKE_POSE
    ON_PLACE:
        WHEN: @PLACE
        DO: @START_PLACE
    ON_PLACE_DONE:
        WHEN: @PLACE_DONE
        DO: @FINISH_PLACE
}
