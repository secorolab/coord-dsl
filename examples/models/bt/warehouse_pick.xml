<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="warehouse_pick">
  <BehaviorTree ID="warehouse_pick">
    <Sequence _while="power_on == true" _onHalted="cleanup := true">
      <SetBlackboard value="0" output_key="retries" />
      <Fallback>
        <battery_ok min_level="0.2" />
        <go_charge dock="home_dock" />
      </Fallback>
      <RunOnce>
        <Script code="mission_status := 'started'" />
      </RunOnce>
      <SubTree ID="perceive" target="{target_object}" pose="{pick_pose}" name="find" />
      <SubTree ID="navigate" goal="{pick_pose}" estop="{estop}" />
      <Precondition if="battery &gt; 0.1" else="FAILURE">
        <SubTree ID="grasp" object="{target_object}" width="{gripper_width}" _onSuccess="picked := true" />
      </Precondition>
      <ReactiveSequence>
        <holding object="{target_object}" _skipIf="aborted == true" />
        <SubTree ID="navigate" goal="{place_pose}" estop="{estop}" />
      </ReactiveSequence>
      <Switch2 variable="{target_object}" case_1="fragile" case_2="heavy">
        <ForceSuccess>
          <place object="{target_object}" surface="{place_pose}" />
        </ForceSuccess>
        <place object="{target_object}" surface="{place_pose}" />
        <place object="{target_object}" surface="{place_pose}" />
      </Switch2>
      <ParallelAll max_failures="1">
        <open_gripper />
        <Script code="mission_status := 'done'" />
      </ParallelAll>
      <WhileDoElse>
        <holding object="{target_object}" />
        <Delay delay_msec="500">
          <open_gripper />
        </Delay>
        <ForceSuccess>
          <AlwaysFailure />
        </ForceSuccess>
      </WhileDoElse>
      <Repeat num_cycles="2" _post="cycles := cycles + 1">
        <Fallback>
          <at_goal goal="{place_pose}" tolerance="0.1" _successIf="reached == true" />
          <ForceFailure>
            <Sleep msec="100" />
          </ForceFailure>
        </Fallback>
      </Repeat>
      <LoopString queue="{waypoints}" value="{wp}">
        <move_to goal="{wp}" frame="map" speed="0.3" precise="false" />
      </LoopString>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="grasp">
    <Sequence>
      <open_gripper />
      <Parallel success_count="1" failure_count="1">
        <close_gripper width="{width}" />
        <KeepRunningUntilFailure>
          <inspect object="{object}" result="{grip_status}" />
        </KeepRunningUntilFailure>
      </Parallel>
      <holding object="{object}" />
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="navigate">
    <SequenceWithMemory>
      <IfThenElse>
        <at_goal goal="{goal}" tolerance="0.05" />
        <AlwaysSuccess />
        <RetryUntilSuccessful num_attempts="3" _onFailure="nav_fails := nav_fails + 1">
          <Timeout msec="5000">
            <move_to goal="{goal}" frame="map" speed="0.5" precise="true" _failureIf="estop == true" start_event="ev:move-start" end_event="ev:move-end" />
          </Timeout>
        </RetryUntilSuccessful>
      </IfThenElse>
    </SequenceWithMemory>
  </BehaviorTree>
  <BehaviorTree ID="perceive">
    <ReactiveFallback>
      <object_visible target="{target}" />
      <Sequence>
        <Script code="attempts := 1" />
        <detect_object target="{target}" pose="{pose}" />
      </Sequence>
    </ReactiveFallback>
  </BehaviorTree>
  <TreeNodesModel>
    <Action ID="close_gripper">
      <inout_port name="width" type="double" />
    </Action>
    <Action ID="detect_object">
      <output_port name="pose" type="pose" />
      <input_port name="target" type="string" />
    </Action>
    <Action ID="go_charge">
      <input_port name="dock" type="string" />
    </Action>
    <Action ID="inspect">
      <input_port name="object" type="string" />
      <output_port name="result" type="string" />
    </Action>
    <Action ID="move_to">
      <input_port name="frame" type="string" />
      <input_port name="goal" type="pose" />
      <input_port name="precise" type="bool" />
      <input_port name="speed" type="double" />
      <input_port name="start_event" />
      <input_port name="end_event" />
    </Action>
    <Action ID="open_gripper" />
    <Action ID="place">
      <input_port name="object" type="string" />
      <input_port name="surface" type="pose" />
    </Action>
    <Condition ID="at_goal">
      <input_port name="goal" type="pose" />
      <input_port name="tolerance" type="double" />
    </Condition>
    <Condition ID="battery_ok">
      <input_port name="min_level" type="double" />
    </Condition>
    <Condition ID="holding">
      <input_port name="object" type="string" />
    </Condition>
    <Condition ID="object_visible">
      <input_port name="target" type="string" />
    </Condition>
    <SubTree ID="grasp">
      <input_port name="object" type="string" />
      <inout_port name="width" type="double" />
    </SubTree>
    <SubTree ID="navigate">
      <input_port name="estop" type="bool" />
      <input_port name="goal" type="pose" />
    </SubTree>
    <SubTree ID="perceive">
      <output_port name="pose" type="pose" />
      <input_port name="target" type="string" />
    </SubTree>
  </TreeNodesModel>
</root>
