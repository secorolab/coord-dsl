ns pp = "https://secorolab.github.io/models/coordination/bt/py-pick/"

fsm right_arm = "../fsms/right_arm.fsm"
fsm gripper = "../fsms/gripper.fsm"

main btree (ns=pp) py_pick {
    sequence {
        send <right_arm.PICK> await <right_arm.PICKED>,
        send <gripper.GRASP> await <gripper.GRASPED> on-fail <gripper.FAULT>
    }
}
