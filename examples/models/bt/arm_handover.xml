<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="arm_handover">
  <BehaviorTree ID="arm_handover">
    <Sequence _onFailure="handover_failed := true" _onSuccess="handover_complete := true">
      <FSMEvent fsm="right_arm" event="PICK" await="PICK_DONE" await_kind="event" />
      <FSMEvent fsm="right_arm" event="HANDOVER" await="HANDOVER_DONE" await_kind="event" />
      <FSMEvent fsm="left_arm" event="TAKE_POSE" await="TAKE_POSE_DONE" await_kind="event" />
      <FSMEvent fsm="left_arm" event="PLACE" await="PLACE_DONE" await_kind="event" />
    </Sequence>
  </BehaviorTree>
  <TreeNodesModel>
    <Action ID="FSMEvent">
      <input_port name="fsm" />
      <input_port name="event" />
      <input_port name="await" />
      <input_port name="await_kind" />
      <input_port name="on_fail" />
      <input_port name="on_fail_kind" />
    </Action>
  </TreeNodesModel>
</root>
