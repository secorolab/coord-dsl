ns grip = "https://secorolab.github.io/models/coordination/fsm/gripper/"

FSM (ns=grip) gripper {
STATES: IDLE,GRASPING,GRASPED,FAULT
START_STATE: @IDLE
END_STATE: @GRASPED
EVENTS: GRASP,GRASPED_OK,GRASP_FAULT
TRANSITIONS:
    START_GRASP:
        FROM: @IDLE
        TO: @GRASPING
    FINISH_GRASP:
        FROM: @GRASPING
        TO: @GRASPED
    FAIL_GRASP:
        FROM: @GRASPING
        TO: @FAULT
REACTIONS:
    ON_GRASP:
        WHEN: @GRASP
        DO: @START_GRASP
    ON_GRASPED_OK:
        WHEN: @GRASPED_OK
        DO: @FINISH_GRASP
    ON_GRASP_FAULT:
        WHEN: @GRASP_FAULT
        DO: @FAIL_GRASP
}
