ns ex = "http://example.org/"

fsm (ns=ex) ex_fsm {
    description: "Example of a simple FSM"

    states {
        S_START,
        S-CONFIGURE,
        S_IDLE,
        S-COMPILE,
        S_EXECUTE,
        S_EXIT
    }

    events {
        E-CONFIGURE-ENTERED,
        E-CONFIGURE-EXIT,
        E_IDLE_ENTERED,
        E_IDLE_EXIT_EXECUTE,
        E_IDLE_EXIT_COMPILE,
        E-COMPILE-ENTERED,
        E-COMPILE-EXIT,
        E_EXECUTE_ENTERED,
        E_EXECUTE_EXIT,
        e-step,
        e-exit
    }

    start: <S_START>
    end:   <S_EXIT>

    transitions {
        T_START_CONFIGURE { from: <S_START>,     to: <S-CONFIGURE> },
        T_CONFIGURE_IDLE  { from: <S-CONFIGURE>, to: <S_IDLE> },
        T_IDLE_IDLE       { from: <S_IDLE>,      to: <S_IDLE> },
        T_IDLE_EXECUTE    { from: <S_IDLE>,      to: <S_EXECUTE> },
        T_IDLE_COMPILE    { from: <S_IDLE>,      to: <S-COMPILE> },
        T_COMPILE_EXECUTE { from: <S-COMPILE>,   to: <S_EXECUTE> },
        T_EXECUTE_EXECUTE { from: <S_EXECUTE>,   to: <S_EXECUTE> },
        T_EXECUTE_IDLE    { from: <S_EXECUTE>,   to: <S_IDLE> },
        T_IDLE_EXIT       { from: <S_IDLE>,      to: <S_EXIT> }
    }

    reactions {
        R_E_CONFIGURE_EXIT {
            when: <E-CONFIGURE-EXIT>,
            do:   <T_CONFIGURE_IDLE>,
            fires { <E_IDLE_ENTERED> }
        },
        R_E_IDLE_EXIT_EXECUTE {
            when: <E_IDLE_EXIT_EXECUTE>,
            do:   <T_IDLE_EXECUTE>,
            fires { <E_EXECUTE_ENTERED> }
        },
        R_E_IDLE_EXIT_COMPILE {
            when: <E_IDLE_EXIT_COMPILE>,
            do:   <T_IDLE_COMPILE>,
            fires { <E-COMPILE-ENTERED> }
        },
        R_E_COMPILE_EXIT {
            when: <E-COMPILE-EXIT>,
            do:   <T_COMPILE_EXECUTE>,
            fires { <E_EXECUTE_ENTERED> }
        },
        R_E_EXECUTE_EXIT {
            when: <E_EXECUTE_EXIT>,
            do:   <T_EXECUTE_IDLE>,
            fires { <E_IDLE_ENTERED> }
        },
        R_E_EXIT  { when: <e-exit>, do: <T_IDLE_EXIT> },

        R_E_STEP1 {
            when: <e-step>,
            do:   <T_START_CONFIGURE>,
            fires { <E-CONFIGURE-ENTERED>, <e-step> }
        },
        R_E_STEP2 { when: <e-step>, do: <T_IDLE_IDLE> },
        R_E_STEP3 { when: <e-step>, do: <T_EXECUTE_EXECUTE> }
    }
}
