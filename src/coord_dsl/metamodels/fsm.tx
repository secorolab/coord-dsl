import base
import event_loop

Model:
    imports*=Import
    namespaces*=NamespaceDeclare
    event_loops*=EventLoop
    fsm=FSM
;

FSM:
    "fsm" "(" "ns" "=" ns=[NamespaceDeclare|FQN] ")" name=IRI_TRUNK "{"
        ("description" ":" description=STRING)?
        "states" "{" states+=State[","] "}"
        "evt" "loop" ":" "<" event_loop=[EventLoop|FQN] ">"
        "start" ":" "<" start_state=[State|FQN] ">"
        "end"   ":" "<" end_state=[State|FQN] ">"
        "transitions" "{" transitions+=Transition[","] "}"
        "reactions"   "{" reactions+=Reaction[","] "}"
    "}"
;

State:
    name=IRI_TRUNK
;

Transition:
    name=IRI_TRUNK "{"
        "from" ":" "<" from_state=[State|FQN] ">" ","
        "to"   ":" "<" to_state=[State|FQN] ">"
    "}"
;

Reaction:
    name=IRI_TRUNK "{"
        "when" ":" "<" when=[Event|FQN] ">" ","
        "do"   ":" "<" do=[Transition|FQN] ">"
        ("," "fires" "{" fires+=EventRef[","] "}")?
    "}"
;
